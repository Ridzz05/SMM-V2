# Contoh konfigurasi server Go. Salin jadi .env lalu sesuaikan.
#
# PENTING: server Go TIDAK membaca berkas .env sendiri. Berkas ini hanya
# catatan nilai yang dibutuhkan. Setel dulu di terminal sebelum menjalankan
# server, misalnya:
#
#   export SESSION_SECRET="$(openssl rand -base64 48)"
#   export ADMIN_PASSWORD="kata-sandi-pilihan-anda"
#   go run ./cmd/server
#
# Di Windows PowerShell, ganti "export" dengan "$env:".

# Port API.
PORT=8080

# Berkas basis data SQLite.
DB_PATH=database.sqlite

# Folder tempat logo mitra disimpan.
UPLOAD_DIR=uploads

# WAJIB, tanpa nilai bawaan. Tanpa ini server menolak start.
# Buat sekali per lingkungan, lalu simpan di manajer rahasia.
SESSION_SECRET=

# Akun admin yang dibuat otomatis saat tabel user masih kosong.
ADMIN_EMAIL=admin@solusimitramandiri.com

# WAJIB untuk membuat akun admin. Bila kosong, akun admin dilewati.
ADMIN_PASSWORD=

# Alamat halaman publik; tujuan pengalihan dari "/".
PUBLIC_SITE_URL=http://localhost:3000

# Alamat yang boleh mengakses API, dipisah koma.
ALLOWED_ORIGINS=http://localhost:3000
