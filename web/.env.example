# Contoh konfigurasi frontend Next.js. Salin jadi .env.local lalu sesuaikan.
# Next.js membaca .env.local otomatis saat "npm run dev" dan "npm run build".

# Alamat server Go yang diteruskan lewat proxy.
# HANYA dibaca saat build. Salah nilai tidak memunculkan galat: halaman tampak
# termuat tetapi tanpa data. Jadi tetapkan dulu sebelum menjalankan build.
API_ORIGIN=http://localhost:8080

# Kode properti Google Analytics. Kosongkan untuk mematikan pelacakan.
NEXT_PUBLIC_GA_ID=
