# --- Go ---
/server.exe
/server
*.exe
*.test
*.out
/coverage.out

# --- Basis data & rahasia ---
/.env
/.env.*
!.env.example
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --- Unggahan pengguna ---
# Isi folder unggahan tidak ikut versi; strukturnya dijaga oleh .gitkeep.
/uploads/*
!/uploads/.gitkeep
!/uploads/gym-partners/
/uploads/gym-partners/*
!/uploads/gym-partners/.gitkeep

# --- Next.js (web/) ---
/web/node_modules
/web/.next
/web/out
/web/build
/web/next-env.d.ts
/web/.turbo
/web/tsconfig.tsbuildinfo
/web/web/
/web/AGENTS.md
/web/CLAUDE.md
# Rahasia frontend. Next membaca .env.local sendiri; yang ikut versi hanya contohnya.
/web/.env
/web/.env.*
!/web/.env.example
# --- Editor & OS ---
/.idea
/.vscode
/.zed
/.nova
.DS_Store
Thumbs.db
*.log

# --- Alat bantu lokal ---
# Pohon kerja sementara milik editor; berisi salinan berkas sumber.
/.kilo/

# --- Berkas kerja sementara ---
# Cuplikan layar verifikasi visual dan skrip sekali pakai. Bukan bagian produk;
# sengaja tidak dihapus agar sesi berikutnya bisa membandingkan tampilan.
/.tmp-*
/web/.tmp-*
*~
